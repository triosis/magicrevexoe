{
  "name": "@magicreviewai/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate:status": "npm run build && node dist/migrations/cli.js status",
    "migrate:up": "npm run build && node dist/migrations/cli.js up",
    "test:migrations": "npm run build && node --test test/migrations.test.mjs",
    "test:migrations:integration": "npm run build && node --test test/migrations.integration.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "mysql2": "^3.24.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
