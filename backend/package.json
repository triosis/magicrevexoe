{
  "name": "@magicreviewai/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/server.js",
    "migrate:status": "npm run build && node dist/migrations/cli.js status",
    "migrate:up": "npm run build && node dist/migrations/cli.js up",
    "test:migrations": "npm run build && node --test test/migrations.test.mjs",
    "test:migrations:integration": "npm run build && node --test test/migrations.integration.mjs",
    "test:schema:integration": "npm run build && node --test test/schema.integration.mjs",
    "test:auth:integration": "npm run build && node --test test/auth.integration.mjs",
    "test:tenants:integration": "npm run build && node --test test/tenants.integration.mjs",
    "test:business:integration": "npm run build && node --test test/business.integration.mjs",
    "test:funnels:integration": "npm run build && node --test test/funnels.integration.mjs",
    "test:feedback:integration": "npm run build && node --test test/feedback.integration.mjs",
    "test:subscriptions:integration": "npm run build && node --test test/subscriptions.integration.mjs",
    "test:quotas:integration": "npm run build && node --test test/quotas.integration.mjs",
    "test": "npm run build && node --test test/*.test.mjs"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "cors": "^2.8.6",
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "jose": "^6.2.15",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.3.1",
    "qrcode": "^1.5.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/qrcode": "^1.5.6",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
