# Copy to backend/.env and replace every placeholder. Never commit backend/.env.
NODE_ENV=development
HOST=127.0.0.1
PORT=3001
# Comma-separated exact frontend origins; no wildcards or paths.
CORS_ORIGINS=http://localhost:5173
DB_HOST=REPLACE_WITH_DATABASE_HOST
DB_PORT=3306
DB_NAME=REPLACE_WITH_DATABASE_NAME
DB_USER=REPLACE_WITH_DATABASE_USER
DB_PASSWORD=REPLACE_WITH_DATABASE_PASSWORD
DB_CONNECTION_LIMIT=5

# Production defaults to verified TLS and a DNS DB_HOST matching the certificate.
# Local disposable development only: disabled. Production defaults to required.
DB_TLS_MODE=disabled
# DB_TLS_CA_FILE=REPLACE_WITH_APPROVED_CA_FILE
# DB_TLS_CA_SHA256=REPLACE_WITH_APPROVED_CA_SHA256
# Production public origins and exact CORS:
# PUBLIC_FUNNEL_ORIGIN=https://api.revexoe.com
# PUBLIC_WEB_ORIGIN=https://revexoe.com
# CORS_ORIGINS=https://revexoe.com
# AUTH_SMTP_HOST=REPLACE_WITH_SMTP_HOST
# AUTH_SMTP_PORT=465
# AUTH_SMTP_SECURITY=implicit
# AUTH_SMTP_USER=REPLACE_WITH_SMTP_USER
# AUTH_SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
# AUTH_MAIL_FROM=REPLACE_WITH_VERIFIED_SENDER
# AUTH_RECOVERY_URL=https://revexoe.com/recover
# Optional private SMTP CA; supply both fields, never disable verification.
# AUTH_SMTP_CA_FILE=REPLACE_WITH_APPROVED_CA_FILE
# AUTH_SMTP_CA_SHA256=REPLACE_WITH_APPROVED_CA_SHA256
# Backup secrets belong to the separate recovery operator, never the app process.

# Supply independently generated secrets through protected environment configuration.
# AUTH_ACCESS_SECRET: canonical base64, 32-128 random bytes; no default.
# AUTH_MFA_KEY: independent canonical base64, exactly 32 random bytes; AES-GCM at rest.
# Both are mandatory with NODE_ENV=production. Never commit actual values.
# AUTH_ACCESS_SECRET=
# AUTH_MFA_KEY=

# Hostinger production: set protected process variables; .env files are NOT loaded.
# Do not deploy the development DB_TLS_MODE above. Default production mode is required.
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=REPLACE_WITH_PROVIDER_ASSIGNED_PORT
# DB_HOST=REPLACE_WITH_PROVIDER_TLS_DNS_HOST
# DB_TLS_MODE=required
# DB_TLS_CA_FILE=REPLACE_WITH_APPROVED_ABSOLUTE_RUNTIME_CA_PATH
# DB_TLS_CA_SHA256=REPLACE_WITH_64_HEX_FILE_BYTE_SHA256
# AUTH_ACCESS_SECRET=REPLACE_WITH_INDEPENDENT_CANONICAL_BASE64_RANDOM_KEY
# AUTH_MFA_KEY=REPLACE_WITH_EXISTING_OR_FIRST_SETUP_BASE64_32_BYTE_KEY
# AUTH_SMTP_TLS_SERVERNAME=REPLACE_WITH_PROVIDER_APPROVED_DNS_IDENTITY
# Optional SMTP servername: normally omit; never use to bypass verification.

# Explicit HOSTINGER_LOCAL exception: implemented/tested locally, NOT approved for
# production activation. See reports/HOSTINGER_LOCAL_IMPLEMENTATION_REPORT.md.
# Select this block instead of required TLS only after separate operator review.
# NODE_ENV=production retains all production authentication/MFA/SMTP validation.
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_TLS_MODE=HOSTINGER_LOCAL
# HOSTINGER_LOCAL_APPROVAL=I_ACCEPT_UNENCRYPTED_LOOPBACK_DATABASE_TRANSPORT
# HOSTINGER_LOCAL_APPROVAL_ID=REPLACE_WITH_REAL_APPROVAL_RECORD
# Reference must be a genuine record, 8-80 ASCII letters/digits/dot/underscore/hyphen,
# starting alphanumeric. REPLACE_WITH_ placeholders are rejected.
# DB_TLS_CA_FILE and DB_TLS_CA_SHA256 MUST BE UNSET, not empty or dummy values.

# Optional Claude: leave the ENTIRE group absent when not configured.
# ANTHROPIC_API_KEY=REPLACE_WITH_PROVIDER_KEY
# ANTHROPIC_MODEL=REPLACE_WITH_APPROVED_CLAUDE_MODEL
# ANTHROPIC_API_VERSION=REPLACE_WITH_APPROVED_YYYY_MM_DD
# AI_MAX_OUTPUT_TOKENS=REPLACE_WITH_APPROVED_INTEGER_64_TO_4096
# ANTHROPIC_FALLBACK_MODEL=REPLACE_WITH_APPROVED_CLAUDE_MODEL

# Optional payment provider: no financial execution is authorized by configuration.
# Leave the group absent while unavailable; do not invent credentials or approvals.
# RAZORPAY_MODE=test
# RAZORPAY_KEY_ID=REPLACE_WITH_PROVIDER_TEST_KEY_ID
# RAZORPAY_KEY_SECRET=REPLACE_WITH_PROVIDER_KEY_SECRET
# RAZORPAY_WEBHOOK_SECRET=REPLACE_WITH_INDEPENDENT_PROVIDER_WEBHOOK_SECRET
# BILLING_LIVE_APPROVAL=REPLACE_WITH_SEPARATELY_REVIEWED_APPROVAL
# Task 22 paid execution hold remains unconditional even with provider configuration.

# Separate operator processes ONLY: not API runtime configuration.
# Legacy migration CLI accepts loopback disposable schemas only.
# MIGRATION_DB_HOST=127.0.0.1
# MIGRATION_DB_PORT=REPLACE_WITH_DISPOSABLE_PORT
# MIGRATION_DB_NAME=REPLACE_WITH_DISPOSABLE_SCHEMA
# MIGRATION_DB_USER=REPLACE_WITH_OPERATOR_USER
# MIGRATION_DB_PASSWORD=REPLACE_WITH_OPERATOR_PASSWORD
# Production operator uses explicit reviewed private target policy, never defaults.
# BOOTSTRAP_DB_USER=REPLACE_WITH_OPERATOR_USER
# BOOTSTRAP_DB_PASSWORD=REPLACE_WITH_OPERATOR_PASSWORD
# BOOTSTRAP_PLATFORM_NAME=REPLACE_WITH_APPROVED_NAME
# BOOTSTRAP_OWNER_EMAIL=REPLACE_WITH_APPROVED_OWNER_EMAIL
# BOOTSTRAP_OWNER_NAME=REPLACE_WITH_APPROVED_OWNER_NAME
# BOOTSTRAP_OWNER_PASSWORD=REPLACE_WITH_PRIVATE_FIRST_SETUP_PASSWORD
# RECOVERY_DB_USER=REPLACE_WITH_DISPOSABLE_RECOVERY_USER
# RECOVERY_DB_PASSWORD=REPLACE_WITH_DISPOSABLE_RECOVERY_PASSWORD
# BACKUP_ENCRYPTION_KEY=REPLACE_WITH_INDEPENDENT_CANONICAL_BASE64_32_BYTE_KEY
# BACKUP_KEY_ID=REPLACE_WITH_NON_SECRET_KEY_VERSION
# Recovery executor remains local/disposable-only. Never run migrations on startup.
