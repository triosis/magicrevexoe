# REVIEW ONLY. NOT a usable production environment file; no real secrets.
NODE_ENV=production
HOST=127.0.0.1
PORT=3001
HTTP_PROXY_MODE=single-nginx-loopback
PUBLIC_FUNNEL_ORIGIN=https://api.revexoe.com
PUBLIC_WEB_ORIGIN=https://revexoe.com
CORS_ORIGINS=https://revexoe.com
AUTH_RECOVERY_URL=https://revexoe.com/recover
# Proposed private name only: owner must approve it and its certificate DNS SAN.
DB_HOST=db.internal.revexoe.com
DB_PORT=3306
DB_NAME=REPLACE_WITH_APPROVED_SCHEMA
DB_USER=REPLACE_WITH_RESTRICTED_RUNTIME_IDENTITY
DB_PASSWORD=REPLACE_WITH_PROTECTED_RUNTIME_CREDENTIAL
DB_CONNECTION_LIMIT=5
DB_TLS_MODE=required
DB_TLS_CA_FILE=/etc/magicreview/db-ca.pem
DB_TLS_CA_SHA256=REPLACE_WITH_APPROVED_EXACT_FILE_SHA256
AUTH_ACCESS_SECRET=REPLACE_WITH_EXISTING_PROTECTED_KEY
AUTH_MFA_KEY=REPLACE_WITH_APPROVED_MATCHING_UNEXPOSED_KEY
AUTH_SMTP_HOST=REPLACE_WITH_APPROVED_SMTP_HOST
AUTH_SMTP_PORT=465
AUTH_SMTP_SECURITY=implicit
AUTH_SMTP_USER=REPLACE_WITH_APPROVED_SMTP_USER
AUTH_SMTP_PASSWORD=REPLACE_WITH_PROTECTED_SMTP_CREDENTIAL
AUTH_MAIL_FROM=REPLACE_WITH_APPROVED_BARE_SENDER_EMAIL
# No HOSTINGER_LOCAL_*, CLOUD_STARTUP_*, MIGRATION_* or BOOTSTRAP_* authority.
# SMTP port/mode must match provider; no new or replacement authentication keys here.
