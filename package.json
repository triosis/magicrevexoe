{
  "name": "magicreviewai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "prepare": "npm run build",
    "start": "node server.mjs",
    "lint": "oxlint",
    "test": "vitest run",
    "test:browser": "node scripts/browser-tests.mjs",
    "test:e2e:real": "npm --prefix backend run build && node --test scripts/e2e-real.mjs",
    "test:server": "node --test test/frontend-server.test.mjs",
    "test:super-admin:browser": "npm --prefix backend run build && node --test scripts/super-admin-login.browser.mjs",
    "typecheck": "tsc -b --pretty false",
    "preview": "vite preview",
    "dev:api": "npm --prefix backend run dev",
    "build:api": "npm --prefix backend run build",
    "typecheck:api": "npm --prefix backend run typecheck",
    "start:api": "npm --prefix backend run start"
  },
  "dependencies": {
    "express": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^29.1.1",
    "oxlint": "^1.88.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.1.0"
  }
}
