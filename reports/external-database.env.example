# Provider-independent worksheet; placeholders intentionally fail validation.
# Never commit a filled copy. Production uses protected process environment, not this file.
# Retain existing signing/MFA keys; do not rotate merely because database moves.
NODE_ENV=production
HOST=0.0.0.0
PORT=REPLACE_WITH_PROVIDER_ASSIGNED_HTTP_PORT
PUBLIC_FUNNEL_ORIGIN=REPLACE_WITH_APPROVED_HTTPS_API_ORIGIN
PUBLIC_WEB_ORIGIN=REPLACE_WITH_APPROVED_HTTPS_WEB_ORIGIN
CORS_ORIGINS=REPLACE_WITH_EXACT_APPROVED_HTTPS_WEB_ORIGINS
AUTH_RECOVERY_URL=REPLACE_WITH_APPROVED_WEB_ORIGIN_PLUS_RECOVER_PATH
DB_HOST=REPLACE_WITH_MANAGED_DATABASE_DNS_WRITER_ENDPOINT
DB_PORT=REPLACE_WITH_MANAGED_DATABASE_PORT
DB_NAME=REPLACE_WITH_APPROVED_EXISTING_SCHEMA
DB_USER=REPLACE_WITH_RESTRICTED_RUNTIME_ACCOUNT
DB_PASSWORD=REPLACE_WITH_PROTECTED_PROVIDER_CREDENTIAL
DB_CONNECTION_LIMIT=5
DB_TLS_MODE=required
DB_TLS_CA_FILE=REPLACE_WITH_APPROVED_ABSOLUTE_RUNTIME_CA_PATH
DB_TLS_CA_SHA256=REPLACE_WITH_APPROVED_64_HEX_FILE_BYTE_HASH
AUTH_ACCESS_SECRET=REPLACE_WITH_EXISTING_PROTECTED_CANONICAL_BASE64_KEY
AUTH_MFA_KEY=REPLACE_WITH_EXISTING_PROTECTED_CANONICAL_BASE64_32_BYTE_KEY
AUTH_SMTP_HOST=REPLACE_WITH_APPROVED_SMTP_DNS_HOST
AUTH_SMTP_PORT=REPLACE_WITH_APPROVED_SMTP_PORT
AUTH_SMTP_SECURITY=REPLACE_WITH_IMPLICIT_OR_STARTTLS_LOWERCASE
AUTH_SMTP_USER=REPLACE_WITH_APPROVED_SMTP_USERNAME
AUTH_SMTP_PASSWORD=REPLACE_WITH_EXISTING_PROTECTED_SMTP_CREDENTIAL
AUTH_MAIL_FROM=REPLACE_WITH_APPROVED_BARE_SENDER_EMAIL
# Optional private SMTP trust: leave both absent unless explicitly required/approved.
# AUTH_SMTP_CA_FILE=REPLACE_WITH_APPROVED_SMTP_CA_PATH
# AUTH_SMTP_CA_SHA256=REPLACE_WITH_APPROVED_SMTP_CA_FILE_HASH
# AUTH_SMTP_TLS_SERVERNAME=REPLACE_WITH_APPROVED_SMTP_CERTIFICATE_DNS_IDENTITY
# Preserve separately approved optional AI configuration; do not add partial groups.
# Payment execution remains held; do not add live approval flags as a DB workaround.
